# Anthropic API key used by Stage 1 Intent Analysis (server-side only)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Folder containing .md intake files.
# Defaults to ./markdowns when unset.
# Absolute paths are supported (local, Synology mounts, network shares), e.g.:
# MARKDOWNS_DIR=/Volumes/10_CORE/chatgpt_exports
# After: open "smb://MMNAS._smb._tcp.local/10_CORE"
# MARKDOWNS_DIR=Z:\chatgpt_exports
MARKDOWNS_DIR=./markdowns
